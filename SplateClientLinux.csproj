<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SplateClient</AssemblyName>
    <Version>2.14.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;dist/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

<ItemGroup>
    <None Update="wwwroot/**;core/**;Assets/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
